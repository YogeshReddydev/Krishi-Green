{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, contact info, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name of the user" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["farmer", "fpo_lead", "admin"], "description": "User role in KrishiGreen" },
        "village": { "type": "string", "description": "Village or Gram Panchayat" },
        "phone": { "type": "string", "description": "Mobile phone number" },
        "landAcres": { "type": "number", "description": "Land size in acres" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "WasteRequest": {
      "title": "WasteRequest",
      "description": "Food and bio-waste collection request logged by farmers or generators",
      "type": "object",
      "properties": {
        "generatorType": { "type": "string", "description": "Type of waste generator (Household, Mandi, Hotel, Farm)" },
        "wasteType": { "type": "string", "description": "Description of organic waste" },
        "estimatedWeightKg": { "type": "number", "description": "Estimated weight in kilograms" },
        "village": { "type": "string", "description": "Pickup village or address" },
        "contactName": { "type": "string", "description": "Name of contact person" },
        "phone": { "type": "string", "description": "Contact phone" },
        "pickupDate": { "type": "string", "description": "Desired pickup date" },
        "status": { "type": "string", "enum": ["Pending Pickup", "Collected", "In Processing", "Completed"], "description": "Status" },
        "notes": { "type": "string", "description": "Additional pickup notes" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["generatorType", "wasteType", "estimatedWeightKg", "village", "status"]
    },
    "ProcessingBatch": {
      "title": "ProcessingBatch",
      "description": "Decentralized bio-fertilizer fermentation and composting batch",
      "type": "object",
      "properties": {
        "batchNo": { "type": "string", "description": "Unique batch tracking identifier" },
        "unitName": { "type": "string", "description": "Name of the processing unit" },
        "operatorName": { "type": "string", "description": "Name of operator" },
        "village": { "type": "string", "description": "Village location" },
        "processType": { "type": "string", "description": "Vermi-composting, Bio-Enzyme, or Jeevamrutha" },
        "inputWasteKg": { "type": "number", "description": "Input waste weight in kg" },
        "startDate": { "type": "string", "description": "Batch initiation date" },
        "estimatedReadyDate": { "type": "string", "description": "Expected completion date" },
        "currentStage": { "type": "string", "description": "Current processing stage" },
        "stageProgressPercent": { "type": "number", "description": "Stage completion percentage" },
        "outputProduct": { "type": "string", "description": "Output bio-fertilizer name" },
        "expectedYieldKg": { "type": "number", "description": "Expected yield in kg" },
        "status": { "type": "string", "description": "Current status" },
        "qrCodeData": { "type": "string", "description": "Verification URL or code" },
        "userId": { "type": "string", "description": "Creator user UID" }
      },
      "required": ["batchNo", "unitName", "processType", "inputWasteKg", "status"]
    },
    "OrganicProduct": {
      "title": "OrganicProduct",
      "description": "Organic input product listed on the KrishiGreen marketplace",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "category": { "type": "string", "description": "Category" },
        "pricePerUnit": { "type": "number", "description": "Price per unit in INR" },
        "unit": { "type": "string", "description": "Packaging unit" },
        "sellerName": { "type": "string", "description": "Seller name" },
        "sellerRole": { "type": "string", "description": "Role of seller" },
        "village": { "type": "string", "description": "Seller village" },
        "availableStock": { "type": "number", "description": "Stock count" },
        "batchNo": { "type": "string", "description": "Batch reference code" },
        "description": { "type": "string", "description": "Product details" },
        "organicCertified": { "type": "boolean", "description": "Certification flag" },
        "qrTraceabilityCode": { "type": "string", "description": "QR code" },
        "image": { "type": "string", "description": "Image URL" },
        "userId": { "type": "string", "description": "Seller user UID" }
      },
      "required": ["name", "pricePerUnit", "unit", "sellerName"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Helpline and advisory support ticket logged for farmers",
      "type": "object",
      "properties": {
        "callerName": { "type": "string", "description": "Name of caller" },
        "phone": { "type": "string", "description": "Caller phone" },
        "language": { "type": "string", "description": "Language of interaction" },
        "category": { "type": "string", "description": "Query category" },
        "query": { "type": "string", "description": "Question or request" },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"], "description": "Ticket status" },
        "resolutionNotes": { "type": "string", "description": "Agronomist or AI response" },
        "priority": { "type": "string", "description": "Ticket priority" },
        "createdAt": { "type": "string", "description": "Timestamp" },
        "userId": { "type": "string", "description": "User UID if signed in" }
      },
      "required": ["category", "query", "status"]
    },
    "VerifiedProvider": {
      "title": "VerifiedProvider",
      "description": "Verified machinery dealership, CHC, baler or compost facility in pilot districts",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "description": "Business name" },
        "district": { "type": "string", "description": "AP Pilot district" },
        "headquartersOrMandal": { "type": "string", "description": "Mandal or town" },
        "address": { "type": "string", "description": "Full address" },
        "category": { "type": "string", "description": "Provider category" },
        "publicPhone": { "type": "string", "description": "Contact phone" },
        "verificationStatus": { "type": "string", "description": "Verification status" },
        "sourceName": { "type": "string", "description": "Data source authority" }
      },
      "required": ["businessName", "district", "category"]
    },
    "ProviderEnquiry": {
      "title": "ProviderEnquiry",
      "description": "Direct quotation and rental enquiry sent to equipment providers",
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "description": "Target provider ID" },
        "providerName": { "type": "string", "description": "Provider business name" },
        "farmerName": { "type": "string", "description": "Enquiring farmer name" },
        "farmerPhone": { "type": "string", "description": "Contact phone" },
        "district": { "type": "string", "description": "District" },
        "status": { "type": "string", "description": "Enquiry status" }
      },
      "required": ["providerId", "farmerName", "farmerPhone"]
    },
    "WasteLifecycleRecord": {
      "title": "WasteLifecycleRecord",
      "description": "Complete 16-stage verifiable waste-to-wealth audit record",
      "type": "object",
      "properties": {
        "currentStage": { "type": "string", "description": "Active stage name" },
        "stageNumber": { "type": "number", "description": "Stage number from 1 to 16" },
        "district": { "type": "string", "description": "Pilot district" },
        "wasteType": { "type": "string", "description": "Waste type" },
        "declaredWeightKg": { "type": "number", "description": "Weight in kg" }
      },
      "required": ["currentStage", "stageNumber", "wasteType"]
    },
    "CarbonProject": {
      "title": "CarbonProject",
      "description": "Indian Carbon Market (BEE / CCTS) project with gross-to-net emissions accounting",
      "type": "object",
      "properties": {
        "projectTitle": { "type": "string", "description": "Project title" },
        "district": { "type": "string", "description": "AP District" },
        "methodologyCode": { "type": "string", "description": "ICM methodology code" },
        "grossAvoidedTCO2e": { "type": "number", "description": "Gross tCO2e avoided" },
        "netIssuedCreditsTCO2e": { "type": "number", "description": "Net credits" },
        "farmerPoolPayoutINR": { "type": "number", "description": "70% farmer share" },
        "lifecycleStage": { "type": "string", "description": "Lifecycle stage" }
      },
      "required": ["projectTitle", "district", "methodologyCode", "lifecycleStage"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/waste_requests/{requestId}": {
      "schema": "WasteRequest",
      "description": "Organic waste collection requests"
    },
    "/processing_batches/{batchId}": {
      "schema": "ProcessingBatch",
      "description": "Decentralized bio-processing and composting batches"
    },
    "/organic_products/{productId}": {
      "schema": "OrganicProduct",
      "description": "Marketplace organic fertilizers and bio-stimulants"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "24x7 helpline farmer support tickets"
    },
    "/verified_providers/{providerId}": {
      "schema": "VerifiedProvider",
      "description": "Verified machinery and biomass providers in AP pilot districts"
    },
    "/provider_enquiries/{enquiryId}": {
      "schema": "ProviderEnquiry",
      "description": "Machinery and rental quotation enquiries"
    },
    "/waste_lifecycle_events/{eventId}": {
      "schema": "WasteLifecycleRecord",
      "description": "16-stage verifiable waste-to-wealth lifecycle records"
    },
    "/carbon_projects/{projectId}": {
      "schema": "CarbonProject",
      "description": "BEE / ICM certified agricultural carbon projects"
    }
  }
}
