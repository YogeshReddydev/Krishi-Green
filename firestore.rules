rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCollectionOperator() {
      return hasRole('collection_operator') || isAdmin();
    }

    function isProcessingOperator() {
      return hasRole('processing_operator') || isAdmin();
    }

    function isEquipmentOperator() {
      return hasRole('equipment_operator') || isAdmin();
    }

    function isVerifier() {
      return hasRole('verifier') || isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Waste collection requests ─────────────────────────────────────────────
    // Farmers can create their own requests; operators and admins can update.
    // Public read is intentionally denied — only authenticated users see requests.
    match /waste_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isCollectionOperator();
      allow delete: if isAdmin();
    }

    // ── Processing batches ────────────────────────────────────────────────────
    // Public read for QR traceability; writes restricted to processing operators.
    match /processing_batches/{batchId} {
      allow read: if true; // QR code public verification
      allow create, update: if isProcessingOperator();
      allow delete: if isAdmin();
    }

    // ── Organic products / AGA ────────────────────────────────────────────────
    match /organic_products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isProcessingOperator();
    }

    // ── Support tickets ───────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if true; // Any visitor can submit a support request
      allow update: if isAdmin() || isCollectionOperator();
      allow delete: if false;
    }

    // ── Verified providers (equipment hubs) ───────────────────────────────────
    match /verified_providers/{providerId} {
      allow read: if true; // Public discovery
      allow create: if isAuthenticated();
      allow update, delete: if isEquipmentOperator();
    }

    // ── Provider enquiries ────────────────────────────────────────────────────
    match /provider_enquiries/{enquiryId} {
      allow read: if isAuthenticated();
      allow create: if true; // Farmers without accounts can still enquire
      allow update, delete: if isEquipmentOperator();
    }

    // ── Waste lifecycle events (16-stage pipeline) ────────────────────────────
    match /waste_lifecycle_events/{eventId} {
      allow read: if true; // Public traceability
      allow create, update: if isCollectionOperator() || isProcessingOperator();
      allow delete: if isAdmin();
    }

    // ── Carbon projects ───────────────────────────────────────────────────────
    match /carbon_projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Carbon monitoring evidence ────────────────────────────────────────────
    match /carbon_monitoring_records/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isVerifier();
      allow delete: if isAdmin();
    }

    // ── Audit log (append-only) ───────────────────────────────────────────────
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Server-side writes; no update/delete
      allow update, delete: if false;
    }

    // ── CSR contributions ─────────────────────────────────────────────────────
    match /csr_contributions/{contribId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Marketplace listings (user-submitted) ─────────────────────────────────
    match /marketplace_listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.createdBy;
      allow delete: if isAdmin();
    }
  }
}
