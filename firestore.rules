rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Waste collection requests
    match /waste_requests/{requestId} {
      allow read: if true;
      allow create: if true; // Farmers can request pickup without friction
      allow update, delete: if isAuthenticated();
    }

    // Bio-Processing Batches
    match /processing_batches/{batchId} {
      allow read: if true; // Public QR verification
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Marketplace Products
    match /organic_products/{productId} {
      allow read: if true; // Public marketplace browsing
      allow create, update, delete: if isAuthenticated();
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if true; // 24x7 phone callers can log tickets freely
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
