rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Waste collection requests
    match /waste_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Bio-Processing Batches
    match /processing_batches/{batchId} {
      allow read: if true; // Public QR verification
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Marketplace Products
    match /organic_products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Verified Machinery & Biomass Providers (Andhra Pradesh Pilot)
    match /verified_providers/{providerId} {
      allow read: if true;
      allow create: if true; // Ground representatives and farmers can submit listings
      allow update, delete: if isAuthenticated();
    }

    // Provider Quotation Enquiries
    match /provider_enquiries/{enquiryId} {
      allow read: if true;
      allow create: if true; // Farmers can submit rental enquiries without friction
      allow update, delete: if isAuthenticated();
    }

    // 16-Stage Waste-to-Wealth Verifiable Lifecycle Records
    match /waste_lifecycle_events/{eventId} {
      allow read: if true;
      allow create, update: if true; // Verifiable event tracking across weighbridge and lab nodes
      allow delete: if isAuthenticated();
    }

    // Carbon Projects (BEE / CCTS Indian Carbon Market)
    match /carbon_projects/{projectId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }
  }
}
